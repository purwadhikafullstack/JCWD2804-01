generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" 
  url      = env("DATABASE_URL")
}

model User {
  user_id       Int      @id @default(autoincrement())
  firstname     String   @db.VarChar(45)
  lastname      String?  @db.VarChar(45)  // Optional
  email         String   @db.VarChar(45) @unique
  phonenumber   Float?   @db.Double       // Optional
  password      String   @db.VarChar(255)
  birth         String?  @db.VarChar(45)  // Optional
  identitynumber Float?  @db.Double       // Optional
  address       String?  @db.VarChar(45)  // Optional
  gender        String?  @db.VarChar(45)  // Optional
  role          Role     @default(USER)
  profile_picture Int?
  email_verified Boolean @db.TinyInt @default(false)
  
  // Relations
  Tenants       Tenant[]
  Bookings      Booking[]
}

model Tenant {
  tenant_id       Int      @id @default(autoincrement())
  user_id         Int
  business_name   String   @db.VarChar(45)
  business_address String  @db.VarChar(45)
  business_phone  Float    @db.Double
  Properties      Property[]
  Sales_Reports   Sales_Report[]

  User            User     @relation(fields: [user_id], references: [user_id])
}

model Property {
  property_id      Int      @id @default(autoincrement())
  tenant_id        Int
  property_name    String   @db.VarChar(45)
  property_location String  @db.MediumText
  description      String   @db.LongText
  category_id      Int
  is_available     Boolean  @db.TinyInt
  property_picture String   @db.VarChar(45)
  
  // Relations
  Tenants          Tenant   @relation(fields: [tenant_id], references: [tenant_id])
  Rooms            Room[]
  Sales_Reports    Sales_Report[]
  Reviews          Review[]
}

model Room {
  room_id          Int      @id @default(autoincrement())
  property_id      Int
  room_type        String   @db.VarChar(45)
  price            Decimal  @db.Decimal(12, 2)
  description      String   @db.LongText
  is_available     Boolean  @db.TinyInt
  room_picture     String   @db.VarChar(45)
  adjustprice      Decimal  @db.Decimal(12, 2)
  occupants        Int
  
  // Relations
  Bookings         Booking[]
  Property         Property @relation(fields: [property_id], references: [property_id])
}

model Booking {
  booking_id       Int      @id @default(autoincrement())
  user_id          Int
  room_id          Int
  check_in         String   @db.VarChar(45)
  check_out        String   @db.VarChar(45)
  status           String   @db.VarChar(45)
  total_price      Decimal  @db.Decimal(12, 2)
  payment_proof    String   @db.VarChar(45)
  
  // Relations
  User             User     @relation(fields: [user_id], references: [user_id])
  Room             Room     @relation(fields: [room_id], references: [room_id])
  Reviews          Review[]
}

model Review {
  review_id       Int      @id @default(autoincrement())
  booking_id      Int
  property_id     Int
  comment         String   @db.MediumText
  tenant_replay   String   @db.MediumText
  star_rating     Int
  total_reviews   Int
  average_rating  Int
  
  // Relations
  Property        Property @relation(fields: [property_id], references: [property_id])
  Booking         Booking  @relation(fields: [booking_id], references: [booking_id])
}

model Sales_Report {
  report_id       Int      @id @default(autoincrement())
  tenant_id       Int
  property_id     Int
  total_sales     Decimal  @db.Decimal(12, 2)
  start_date      DateTime
  end_date        DateTime
  
  // Relations
  Tenant          Tenant   @relation(fields: [tenant_id], references: [tenant_id])
  Property        Property @relation(fields: [property_id], references: [property_id])
}

enum Role {
  USER
  ADMIN
}
